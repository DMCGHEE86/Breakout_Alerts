<UserControl
    x:Class="BreakoutAlerts.App.Views.TradingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:BreakoutAlerts.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullableNumberConverter x:Key="NullableNumber" />
        <conv:BoolToDirectionBrushConverter x:Key="BoolToDirectionBrush" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ ACCOUNT + TICKET ============  -->
        <Border
            Grid.Column="0"
            Margin="0,0,8,0"
            Padding="14,12"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderText}" Text="ACCOUNT" />

                <ComboBox
                    Margin="0,10,0,0"
                    DisplayMemberPath="Description"
                    ItemsSource="{Binding Accounts}"
                    SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" />

                <!--
                    A live account is stated in full, in the warning colour, every time.
                    The distinction between paper and real money is the single most
                    consequential piece of state in this application and it must never be
                    something the user has to go looking for.
                -->
                <Border
                    Margin="0,8,0,0"
                    Padding="10,6"
                    Background="#5A3A00"
                    BorderBrush="{StaticResource AppWarningBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding IsLiveAccount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource AppWarningBrush}"
                        Text="LIVE ACCOUNT - REAL MONEY"
                        TextWrapping="Wrap" />
                </Border>

                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="11"
                    Foreground="{StaticResource AppDownBrush}"
                    Text="{Binding AccountWarning}"
                    TextWrapping="Wrap" />

                <!--
                    Both figures, named for what they are. The broker reports Cash and Power
                    separately and on a margin account Power is the 2:1 figure - labelling
                    that "buying power" made the app disagree with the moomoo app, which
                    shows cash. Long options are paid for in full, so Cash is the number that
                    actually constrains an order here; Power is shown for context, not as the
                    headline.
                -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource AppTextTertiaryBrush}"
                            Text="Cash" />
                        <TextBlock
                            FontFamily="{StaticResource AppNumericFont}"
                            FontSize="13"
                            Foreground="{StaticResource AppTextPrimaryBrush}"
                            Text="{Binding SelectedAccount.Cash, StringFormat={}{0:N2}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource AppTextTertiaryBrush}"
                            Text="Margin power" />
                        <TextBlock
                            FontFamily="{StaticResource AppNumericFont}"
                            FontSize="13"
                            Foreground="{StaticResource AppTextSecondaryBrush}"
                            Text="{Binding SelectedAccount.BuyingPower, StringFormat={}{0:N2}}" />
                    </StackPanel>
                </Grid>

                <!--
                    Where to unlock, shown for every live account. Not a password box: the GUI
                    build of OpenD refuses API unlocks outright ("The GUI version of OpenD has
                    disabled the unlock interface"), so the trade password is entered in
                    OpenD's own window and this application never handles it.

                    Shown unconditionally rather than "while locked" because nothing in the API
                    reports whether OpenD is unlocked. The page can say where to do it; it
                    cannot know whether it has been done. If it has not, the broker refuses the
                    order and its message appears in the result line below.
                -->
                <Border
                    Margin="0,10,0,0"
                    Padding="12,10"
                    Background="{StaticResource AppSurfaceElevatedBrush}"
                    BorderBrush="{StaticResource AppWarningBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsLiveAccount, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AppWarningBrush}"
                            Text="UNLOCK TRADING IN OpenD"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{StaticResource AppTextSecondaryBrush}"
                            Text="Click Unlock Trading at the top right of the OpenD window and enter your 6-digit trade password there. This app never asks for it."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Separator Margin="0,14" Background="{StaticResource AppBorderBrush}" />

                <!--  ============ TICKET ============  -->
                <TextBlock Style="{StaticResource SectionHeaderText}" Text="ORDER TICKET" />

                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="11"
                    Foreground="{StaticResource AppTextTertiaryBrush}"
                    Text="No ticket open. Open one from a candidate on the Dashboard."
                    TextWrapping="Wrap"
                    Visibility="{Binding IsTicketOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                <StackPanel Visibility="{Binding IsTicketOpen, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="0,10,0,0"
                        FontFamily="{StaticResource AppNumericFont}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppTextPrimaryBrush}"
                        Text="{Binding TicketContract}" />

                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock FontSize="11" Foreground="{StaticResource AppTextTertiaryBrush}" Text="bid" />
                        <TextBlock
                            Margin="4,0,10,0"
                            FontFamily="{StaticResource AppNumericFont}"
                            FontSize="11"
                            Foreground="{StaticResource AppTextSecondaryBrush}"
                            Text="{Binding TicketBid, Converter={StaticResource NullableNumber}}" />
                        <TextBlock FontSize="11" Foreground="{StaticResource AppTextTertiaryBrush}" Text="ask" />
                        <TextBlock
                            Margin="4,0,0,0"
                            FontFamily="{StaticResource AppNumericFont}"
                            FontSize="11"
                            Foreground="{StaticResource AppTextSecondaryBrush}"
                            Text="{Binding TicketAsk, Converter={StaticResource NullableNumber}}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,12,0,4"
                        FontSize="11"
                        Foreground="{StaticResource AppTextTertiaryBrush}"
                        Text="Contracts" />
                    <ui:NumberBox Minimum="1" Value="{Binding TicketQuantity, Mode=TwoWay}" />

                    <TextBlock
                        Margin="0,10,0,4"
                        FontSize="11"
                        Foreground="{StaticResource AppTextTertiaryBrush}"
                        Text="Limit price" />
                    <ui:NumberBox
                        IsEnabled="{Binding IsLimitOrder}"
                        SmallChange="0.01"
                        Value="{Binding TicketLimitPrice, Mode=TwoWay}" />

                    <!--
                        Market is opt-in and resets to limit on every new ticket. Option
                        spreads are wide enough that a market order can fill materially away
                        from the price the candidate row showed, so the safer choice has to
                        be the one that happens by default.
                    -->
                    <CheckBox
                        Margin="0,12,0,0"
                        Content="Send at market instead of limit"
                        Foreground="{StaticResource AppTextSecondaryBrush}"
                        IsChecked="{Binding IsMarketOrder, Mode=TwoWay}" />

                    <!--
                        The broker has no bracket order, so this stop is NOT sent with the
                        entry. It is recorded, persisted to disk, and submitted once the entry
                        fills - which is what moomoo's own ticket must also be doing, since the
                        protocol has no field for it. The wording below says so, because a
                        trader who thinks the stop is already resting at the broker would be
                        wrong about what protects them.
                    -->
                    <CheckBox
                        Margin="0,12,0,0"
                        Content="Attach a stop loss"
                        Foreground="{StaticResource AppTextSecondaryBrush}"
                        IsChecked="{Binding TicketUseStopLoss, Mode=TwoWay}" />

                    <StackPanel Visibility="{Binding TicketUseStopLoss, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,8,0,4"
                            FontSize="11"
                            Foreground="{StaticResource AppTextTertiaryBrush}"
                            Text="Stop price (GTC)" />
                        <ui:NumberBox SmallChange="0.01" Value="{Binding TicketStopPrice, Mode=TwoWay}" />

                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="10"
                            Foreground="{StaticResource AppWarningBrush}"
                            Text="Placed at the broker immediately, alongside the entry. It rests there whether this app is running or not. Cancelling the entry here also cancels the stop."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--
                        Two steps, deliberately. Filling the ticket arms it; a separate
                        confirmation sends it, and that confirmation restates every field
                        exactly as it will be transmitted. One-click ordering from a scanner
                        is the interaction that turns a misread row into a position.
                    -->
                    <ui:Button
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ReviewOrderCommand}"
                        Content="Review order"
                        Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                    <Border
                        Margin="0,14,0,0"
                        Padding="12,10"
                        Background="{StaticResource AppSurfaceElevatedBrush}"
                        BorderBrush="{StaticResource AppWarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource AppTextPrimaryBrush}"
                                Text="{Binding ConfirmationSummary}"
                                TextWrapping="Wrap" />

                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <ui:Button
                                    Appearance="Danger"
                                    Command="{Binding ConfirmOrderCommand}"
                                    Content="CONFIRM AND SEND" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Command="{Binding CloseTicketCommand}"
                                    Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ui:Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding CloseTicketCommand}"
                        Content="Discard ticket"
                        Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                </StackPanel>

                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="11"
                    Foreground="{StaticResource AppTextSecondaryBrush}"
                    Text="{Binding LastResult}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  ============ ORDERS ============  -->
        <Border
            Grid.Column="1"
            Padding="14,12"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SectionHeaderText}" Text="ORDERS" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource AppTextTertiaryBrush}">
                        <Run Text="{Binding OpenOrderCount, Mode=OneWay}" />
                        <Run Text="open" />
                    </TextBlock>
                    <ui:Button
                        Margin="16,0,0,0"
                        Padding="10,3"
                        Command="{Binding RefreshOrdersCommand}"
                        Content="Refresh"
                        FontSize="11" />
                </StackPanel>

                <DataGrid
                    Grid.Row="1"
                    CellStyle="{StaticResource DataGridCellBase}"
                    ColumnHeaderStyle="{StaticResource DataGridHeaderRight}"
                    ItemsSource="{Binding Orders}"
                    RowStyle="{StaticResource DataGridRowBase}"
                    Style="{StaticResource DataGridBase}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="80" Header="TIME">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumericText}" Text="{Binding TimeDisplay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="70" Header="ENV">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource AppWarningBrush}"
                                        Text="{Binding EnvironmentText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="200" Header="CONTRACT">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontFamily="{StaticResource AppNumericFont}"
                                        FontSize="12"
                                        Foreground="{Binding IsBuy, Converter={StaticResource BoolToDirectionBrush}}"
                                        Text="{Binding ContractCode}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="60" Header="SIDE">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{Binding IsBuy, Converter={StaticResource BoolToDirectionBrush}}"
                                        Text="{Binding SideText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="60" Header="QTY">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumericText}" Text="{Binding Quantity}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="90" Header="PRICE">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumericText}" Text="{Binding Price, Converter={StaticResource NullableNumber}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="140" Header="STATUS">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource AppTextPrimaryBrush}"
                                        Text="{Binding StatusText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="90" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button
                                        Padding="8,2"
                                        Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="Cancel"
                                        FontSize="10"
                                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>


