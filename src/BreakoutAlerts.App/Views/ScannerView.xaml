<UserControl
    x:Class="BreakoutAlerts.App.Views.ScannerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:BreakoutAlerts.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:SignToBrushConverter x:Key="SignToBrush" />
        <conv:SignedPercentConverter x:Key="SignedPercent" />
        <conv:CompactNumberConverter x:Key="CompactNumber" />
        <conv:NullableNumberConverter x:Key="NullableNumber" />
        <conv:RangePositionToBrushConverter x:Key="RangePositionBrush" />
        <conv:RangePositionToTextConverter x:Key="RangePositionText" />

        <!--
            Rows are hidden by collapsing rather than by removing them from the source
            collection. Removing on every keystroke would discard selection and scroll
            position while typing a filter.
        -->
        <Style
            x:Key="FilterableRow"
            BasedOn="{StaticResource DataGridRowBase}"
            TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ TOOLBAR ============  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="12,10"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox
                    Grid.Column="0"
                    PlaceholderText="Filter by symbol or name"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ui:ToggleSwitch
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Content="Breakouts only"
                    IsChecked="{Binding ShowBreakoutsOnly, Mode=TwoWay}" />

                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryText}"
                        Text="{Binding VisibleCount}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryText}"
                        Text="symbols" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ============ GRID ============  -->
        <Border
            Grid.Row="1"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <DataGrid
                Margin="4"
                CellStyle="{StaticResource DataGridCellBase}"
                ColumnHeaderStyle="{StaticResource DataGridHeader}"
                ItemsSource="{Binding Rows}"
                RowStyle="{StaticResource FilterableRow}"
                Style="{StaticResource DataGridBase}">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Width="150" Header="SYMBOL">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AppTextPrimaryBrush}"
                                        Text="{Binding Ticker}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource AppTextTertiaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="105"
                        Header="LAST"
                        HeaderStyle="{StaticResource DataGridHeaderRight}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource NumericText}"
                                    Text="{Binding Last, StringFormat=N2}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="95"
                        Header="CHG"
                        HeaderStyle="{StaticResource DataGridHeaderRight}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Foreground="{Binding Change, Converter={StaticResource SignToBrush}}"
                                    Style="{StaticResource NumericText}"
                                    Text="{Binding Change, StringFormat=N2}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="95"
                        Header="CHG %"
                        HeaderStyle="{StaticResource DataGridHeaderRight}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Foreground="{Binding ChangePercent, Converter={StaticResource SignToBrush}}"
                                    Style="{StaticResource NumericText}"
                                    Text="{Binding ChangePercent, Converter={StaticResource SignedPercent}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="90"
                        Header="VOLUME"
                        HeaderStyle="{StaticResource DataGridHeaderRight}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Foreground="{StaticResource AppTextSecondaryBrush}"
                                    Style="{StaticResource NumericText}"
                                    Text="{Binding Volume, Converter={StaticResource CompactNumber}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Opening range pair, visually grouped by the shared header prefix.  -->
                    <DataGridTemplateColumn
                        Width="100"
                        Header="ORB HIGH"
                        HeaderStyle="{StaticResource DataGridHeaderRight}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumericText}" Text="{Binding OrbHigh, Converter={StaticResource NullableNumber}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="100"
                        Header="ORB LOW"
                        HeaderStyle="{StaticResource DataGridHeaderRight}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumericText}" Text="{Binding OrbLow, Converter={StaticResource NullableNumber}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="100"
                        Header="PM HIGH"
                        HeaderStyle="{StaticResource DataGridHeaderRight}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Foreground="{StaticResource AppTextSecondaryBrush}"
                                    Style="{StaticResource NumericText}"
                                    Text="{Binding PremarketHigh, Converter={StaticResource NullableNumber}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="100"
                        Header="PM LOW"
                        HeaderStyle="{StaticResource DataGridHeaderRight}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Foreground="{StaticResource AppTextSecondaryBrush}"
                                    Style="{StaticResource NumericText}"
                                    Text="{Binding PremarketLow, Converter={StaticResource NullableNumber}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="*" Header="RANGE">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="9,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource AppSurfaceElevatedBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding Position, Converter={StaticResource RangePositionBrush}}"
                                        Text="{Binding Position, Converter={StaticResource RangePositionText}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
