<ui:FluentWindow
    x:Class="BreakoutAlerts.App.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:BreakoutAlerts.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:BreakoutAlerts.App.Views"
    xmlns:vm="clr-namespace:BreakoutAlerts.App.ViewModels"
    Title="BreakoutAlerts"
    Icon="/app.ico"
    Width="1500"
    Height="940"
    MinWidth="1100"
    MinHeight="700"
    Background="{StaticResource AppBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <conv:BoolToDirectionBrushConverter x:Key="BoolToDirectionBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            ViewModel-first navigation. The shell binds a ContentControl to the current
            PageViewModelBase; these templates decide which View renders it. The shell
            therefore never references a concrete page type.
        -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScannerViewModel}">
            <views:ScannerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StrategiesViewModel}">
            <views:StrategiesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TradingViewModel}">
            <views:TradingView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Title bar. Draggable, and supplies the window buttons.  -->
        <ui:TitleBar
            Grid.Row="0"
            Title="BreakoutAlerts"
            Grid.ColumnSpan="2" />

        <!--
            Synthetic-data banner. Full width, high contrast, and impossible to miss.
            An application that quietly serves invented prices while looking exactly like
            it is serving real ones - in a tool used to size real trades - is the most
            damaging failure this codebase could produce. The small nav-rail label was not
            enough; this is.
        -->
        <Border
            Grid.Row="1"
            Padding="16,8"
            Background="#5A3A00"
            BorderBrush="{StaticResource AppWarningBrush}"
            BorderThickness="0,0,0,2"
            Visibility="{Binding IsSyntheticData, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource AppWarningBrush}"
                Text="SYNTHETIC DATA - every price, bar and option quote is generated locally and is NOT real. Testing mode only." />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ============ NAVIGATION RAIL ============  -->
            <Border
                Grid.Column="0"
                Padding="0,0,0,16"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox
                        Grid.Row="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource NavRailItem}"
                        ItemsSource="{Binding NavigationItems}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Width="20"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="15"
                                        Text="{Binding Glyph}" />
                                    <TextBlock
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding Label}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  ============ CONNECTION STATUS ============  -->
                    <!--
                        Pinned to the bottom of the rail so it is always on screen. A feed
                        that has silently dropped is the most dangerous state this app can
                        be in - stale prices that look live - so its indicator must never
                        be somewhere the user has to navigate to.
                    -->
                    <Border
                        Grid.Row="1"
                        Margin="16,8,16,0"
                        Padding="12,10"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{Binding IsConnected, Converter={StaticResource BoolToDirectionBrush}}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource AppTextPrimaryBrush}"
                                    Text="{Binding ConnectionStatus}" />
                            </StackPanel>
                            <TextBlock
                                Margin="16,3,0,0"
                                FontSize="11"
                                Foreground="{StaticResource AppWarningBrush}"
                                Text="{Binding DataSourceLabel}" />

                            <!--
                                After a reboot OpenD is usually not running, and without it
                                this application can do nothing at all. The button only appears
                                while disconnected on the live provider - never on synthetic
                                data, where there is no gateway to start.
                            -->
                            <ui:Button
                                Margin="0,8,0,0"
                                Padding="8,4"
                                HorizontalAlignment="Stretch"
                                Command="{Binding LaunchGatewayCommand}"
                                Content="Start OpenD"
                                FontSize="11"
                                Visibility="{Binding CanLaunchGateway, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="10"
                                Foreground="{StaticResource AppTextTertiaryBrush}"
                                Text="{Binding GatewayMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  ============ CONTENT ============  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="28,20,28,16">
                    <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding CurrentPage.Title}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="{Binding CurrentPage.Subtitle}" />
                </StackPanel>

                <ContentControl
                    Grid.Row="1"
                    Margin="28,0,28,24"
                    Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
